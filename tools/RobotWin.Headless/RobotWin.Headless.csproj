<Project Sdk="Microsoft.NET.Sdk">

  <!-- [api] Cross-platform headless simulator + automation API server (no WPF). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RobotWin.Headless</AssemblyName>
    <RootNamespace>RobotWin.Headless</RootNamespace>
    <Product>RobotWin Studio Headless</Product>
    <Version>2.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CoreSim\src\RobotTwin.CoreSim\RobotTwin.CoreSim.csproj" />
  </ItemGroup>

  <!-- The app's built-in firmware ("builtin:xxx.hex") travels with the headless tool. -->
  <ItemGroup>
    <Content Include="..\..\Studio\RobotWin.Studio\Firmware\*.hex" Link="Firmware\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
