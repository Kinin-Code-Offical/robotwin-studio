<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RobotTwin.CoreSim</RootNamespace>
    <LangVersion>14</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/CoreSim</PathMap>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- ESP32 HAL shim sources, extracted and compiled by Esp32SketchCompiler. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\native\esp32hal\**\*.h;..\..\native\esp32hal\**\*.cpp" LogicalName="esp32hal/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
