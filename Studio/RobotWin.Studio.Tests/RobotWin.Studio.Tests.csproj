<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the WPF-free logic of the studio (updater, news, Markdown, help search).
       The sources are linked, not referenced, so these tests run without WPF and prove the
       logic has no UI dependency. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RobotWin.Studio\Updates\UpdateCore.cs" Link="Linked\UpdateCore.cs" />
    <Compile Include="..\RobotWin.Studio\Updates\InstallProfile.cs" Link="Linked\InstallProfile.cs" />
    <Compile Include="..\RobotWin.Studio\Help\Markdown.cs" Link="Linked\Markdown.cs" />
    <Compile Include="..\RobotWin.Studio\Editor\Completion\*.cs" LinkBase="Linked\Completion" />
    <Compile Include="..\RobotWin.Studio\Shell\Lang.Core.cs" Link="Linked\Lang.Core.cs" />
    <Compile Include="..\RobotWin.Studio\Shell\SolverCosts.cs" Link="Linked\SolverCosts.cs" />
    <Compile Include="..\RobotWin.Studio\Shell\PaletteMatch.cs" Link="Linked\PaletteMatch.cs" />
    <Compile Include="..\RobotWin.Studio\Firmware\ToolchainInfo.cs" Link="Linked\ToolchainInfo.cs" />
    <EmbeddedResource Include="..\RobotWin.Studio\Lang\*.json" LogicalName="RobotWin.Studio.Lang.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\news.json" Link="Fixtures\news.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
