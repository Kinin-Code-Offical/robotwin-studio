<UserControl x:Class="RobotWin.Studio.Pages.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:RobotWin.Studio.Theme"
             Background="{DynamicResource B.Base}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: search and the topic tree -->
        <DockPanel Margin="16,26,10,14">
            <TextBlock DockPanel.Dock="Top" Text="Yardım" Style="{StaticResource Text.Title}" Margin="8,0,0,14"/>
            <Border x:Name="SearchFrame" DockPanel.Dock="Top" Margin="0,0,6,12" Background="{DynamicResource B.Base}" BorderBrush="{DynamicResource B.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource R.Medium}">
                <DockPanel>
                    <t:Icon DockPanel.Dock="Left" Data="{StaticResource I.Search}" Size="14" Foreground="{DynamicResource B.TextMuted}" VerticalAlignment="Center" Margin="10,0,2,0" IsHitTestVisible="False"/>
                    <Button x:Name="ClearSearch" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="24" Margin="0,0,3,0"
                            Visibility="Collapsed" Click="OnClearSearch" ToolTip="Aramayı temizle (Esc)">
                        <t:Icon Data="{StaticResource I.Close}" Size="10"/>
                    </Button>
                    <TextBox x:Name="SearchBox" Tag="Kılavuzda ara…  (Ctrl+F)" BorderThickness="0" Background="Transparent" Padding="2,4" MinHeight="30"
                             TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKey"
                             GotKeyboardFocus="OnSearchFocus" LostKeyboardFocus="OnSearchFocus"/>
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Nav" Margin="0,0,6,0"/>
            </ScrollViewer>
        </DockPanel>
        <Border Grid.Column="1" Background="{DynamicResource B.Border}"/>

        <!-- Right: the selected topic -->
        <Grid Grid.Column="2">
            <ContentControl x:Name="ContentHost" Focusable="False"/>
            <Button x:Name="BackButton" Style="{StaticResource Btn.Icon}" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="12,12,0,0" Visibility="Collapsed" Click="OnBack" ToolTip="Geri (Alt+Sol ok)">
                <t:Icon Data="M15,5 L8,12 L15,19" Size="14"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
