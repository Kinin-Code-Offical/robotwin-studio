<UserControl x:Class="RobotWin.Studio.Pages.SchematicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:RobotWin.Studio.Theme"
             xmlns:ed="clr-namespace:RobotWin.Studio.Editor"
             xmlns:sim="clr-namespace:RobotWin.Studio.Simulation"
             Background="{DynamicResource B.Base}">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition x:Name="DockLineRow" Height="1"/>
            <RowDefinition x:Name="DockRow" Height="300" MinHeight="36"/>
        </Grid.RowDefinitions>

        <!-- ================= Toolbar ================= -->
        <Border Grid.Row="0" Background="{DynamicResource B.Base}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="LibraryToggle" Style="{StaticResource Toggle.Tool}" ToolTip="Parça kütüphanesini göster / gizle" Click="OnToggleLibrary" IsChecked="True" Margin="0,0,6,0">
                        <t:Icon Data="{StaticResource I.Library}" Size="16"/>
                    </ToggleButton>
                    <Border x:Name="ToolSep0" Width="1" Height="16" Background="{DynamicResource B.Border}" Margin="2,0,8,0"/>
                    <!-- [floatbar] the drawing tools tear off into a window of their own (Shell/FloatingStrip.cs) -->
                    <Border x:Name="DrawToolsHost">
                        <StackPanel x:Name="DrawTools" Orientation="Horizontal">
                            <ToggleButton x:Name="ToolSelect" Style="{StaticResource Toggle.Tool}" ToolTip="Seç ve taşı  (Esc)" Click="OnToolClick" Tag="Select" IsChecked="True">
                                <t:Icon Data="{StaticResource I.Pointer}" Size="16"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ToolWire" Style="{StaticResource Toggle.Tool}" ToolTip="Kablo  (W) — bir pine tıklayarak da başlar" Click="OnToolClick" Tag="Wire" Margin="2,0">
                                <t:Icon Data="{StaticResource I.Wire}" Size="16"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ToolLabel" Style="{StaticResource Toggle.Tool}" ToolTip="Hat etiketi  (L) · global etiket (Ctrl+L)" Click="OnToolClick" Tag="Label">
                                <t:Icon Data="{StaticResource I.Label}" Size="16"/>
                            </ToggleButton>
                            <Button Style="{StaticResource Btn.Icon}" ToolTip="Güç sembolü ekle  (P)" Click="OnPowerTool" Margin="2,0,0,0">
                                <t:Icon Data="{StaticResource I.Ground}" Size="16"/>
                            </Button>
                            <ToggleButton x:Name="ToolNoConnect" Style="{StaticResource Toggle.Tool}" ToolTip="Bağlantı yok (NC) işareti  (Q)" Click="OnToolClick" Tag="NoConnect" Margin="2,0,0,0">
                                <t:Icon Data="{StaticResource I.Close}" Size="15"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ToolJunction" Style="{StaticResource Toggle.Tool}" ToolTip="Bağlantı noktası (J): kesişen teller ancak burada birleşir; elle konmuş noktaya tıklayınca ayrılır" Click="OnToolClick" Tag="Junction" Margin="2,0,0,0">
                                <t:Icon Data="{StaticResource I.Junction}" Size="15"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ToolText" Style="{StaticResource Toggle.Tool}" ToolTip="Metin (T): sayfaya not, başlık ya da açıklama; çift tıkla düzenlenir" Click="OnToolClick" Tag="Text" Margin="2,0,0,0">
                                <t:Icon Data="{StaticResource I.Text}" Size="15"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ToolDraw" Style="{StaticResource Toggle.Tool}" ToolTip="Çiz: çizgi, dikdörtgen, daire, yay (çerçeve, bölme, mekanik çizim; hattı yoktur)" Click="OnDrawTool" Margin="2,0,0,0">
                                <t:Icon Data="{StaticResource I.DrawRect}" Size="15"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ToolHighlight" Style="{StaticResource Toggle.Tool}" ToolTip="Hattı vurgula: tıklanan pinin, telin ya da etiketin hattı şemada ve kartta öne çıkar; aynı hatta ya da boşa tıklayınca kalkar (` imleçtekini vurgular)" Click="OnToolClick" Tag="Highlight" Margin="2,0,0,0">
                                <t:Icon Data="{StaticResource I.Eye}" Size="15"/>
                            </ToggleButton>
                            <Button Style="{StaticResource Btn.Icon}" ToolTip="Multimetre uçlarını devreye tak (kırmızı, sonra siyah)" Click="OnPlaceLeads" Margin="2,0,0,0">
                                <t:Icon Data="{StaticResource I.Meter}" Size="16"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="EditTools" Orientation="Horizontal">
                        <Border Width="1" Height="16" Background="{DynamicResource B.Border}" Margin="8,0"/>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Döndür  (R)" Click="OnRotate"><t:Icon Data="{StaticResource I.Rotate}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Aynala  (X)" Click="OnMirror"><t:Icon Data="{StaticResource I.Mirror}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Sil  (Del)" Click="OnDelete"><t:Icon Data="{StaticResource I.Delete}" Size="16"/></Button>
                        <Border Width="1" Height="16" Background="{DynamicResource B.Border}" Margin="8,0"/>
                        <Button x:Name="UndoButton" Style="{StaticResource Btn.Icon}" ToolTip="Geri al  (Ctrl+Z)" Click="OnUndo"><t:Icon Data="{StaticResource I.Undo}" Size="16"/></Button>
                        <Button x:Name="RedoButton" Style="{StaticResource Btn.Icon}" ToolTip="Yinele  (Ctrl+Y)" Click="OnRedo"><t:Icon Data="{StaticResource I.Redo}" Size="16"/></Button>
                        <StackPanel x:Name="EditorExtras" Orientation="Horizontal">
                        <Border Width="1" Height="16" Background="{DynamicResource B.Border}" Margin="8,0"/>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Numaralandır (R?, çakışan tanımlayıcılar)" Click="OnAnnotate"><t:Icon Data="{StaticResource I.Spark}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Elektriksel kural denetimi (ERC)" Click="OnErc"><t:Icon Data="{StaticResource I.Drc}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Bul / değiştir  (Ctrl+F · Ctrl+H)" Click="OnFind"><t:Icon Data="{StaticResource I.Search}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Dışa aktar: BOM, KiCad/SPICE netlist, PNG/SVG, yazdır" Click="OnExportMenu"><t:Icon Data="{StaticResource I.Export}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Kısayollar  (F1 · ?)" Click="OnHelp"><t:Icon Data="{StaticResource I.Info}" Size="16"/></Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                    <ComboBox x:Name="VariantBox" Width="160" Margin="0,0,8,0" Visibility="Collapsed" SelectionChanged="OnVariantPicked" ToolTip="Tasarım alternatifi: simüle edilen, BOM'a ve montaja giren"/>
                    <Button x:Name="RunButton" Style="{StaticResource Btn.Primary}" Padding="12,0" MinHeight="28" Click="OnRun" ToolTip="Başlat / duraklat  (F5)">
                        <StackPanel Orientation="Horizontal">
                            <t:Icon x:Name="RunIcon" Data="{StaticResource I.Play}" Size="13" Filled="True" Foreground="{DynamicResource B.OnPrimary}"/>
                            <TextBlock x:Name="RunText" Text="Simüle et" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource B.OnPrimary}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="1 ms ilerlet" Click="OnStep" Margin="6,0,0,0"><t:Icon Data="{StaticResource I.Step}" Size="14"/></Button>
                    <Button x:Name="StopButton" Style="{StaticResource Btn.Icon}" ToolTip="Durdur  (Shift+F5)" Click="OnStop"><t:Icon Data="{StaticResource I.Stop}" Size="14"/></Button>
                    <ComboBox x:Name="SpeedBox" Width="124" Margin="6,0,0,0" SelectionChanged="OnSpeedChanged" ToolTip="Simülasyon hızı">
                        <ComboBoxItem Content="0.01×" Tag="0.01"/>
                        <ComboBoxItem Content="0.1×" Tag="0.1"/>
                        <ComboBoxItem Content="Gerçek zaman" Tag="1" IsSelected="True"/>
                        <ComboBoxItem Content="5×" Tag="5"/>
                        <ComboBoxItem Content="20×" Tag="20"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SimStatus" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                    <!-- [zoom] KiCad's view toolbar: zoom in, out and fit -->
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="Yakınlaştır (+, tekerlek)" Click="OnZoomIn"><t:Icon Data="{StaticResource I.ZoomIn}" Size="16"/></Button>
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="Uzaklaştır (−, tekerlek)" Click="OnZoomOut"><t:Icon Data="{StaticResource I.ZoomOut}" Size="16"/></Button>
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="Sığdır  (F)" Click="OnFit"><t:Icon Data="{StaticResource I.ZoomFit}" Size="16"/></Button>
                    <ToggleButton x:Name="InspectorToggle" Style="{StaticResource Toggle.Tool}" ToolTip="Özellikler panelini göster / gizle" Click="OnToggleInspector" IsChecked="True" Margin="6,0,0,0">
                        <t:Icon Data="{StaticResource I.Layers}" Size="16"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Main area ================= -->
        <Grid Grid.Row="1" x:Name="MainArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="272" MinWidth="200"/>
                <ColumnDefinition x:Name="LibrarySplitColumn" Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectorSplitColumn" Width="1"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="288" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Canvas (with room on both sides for docked panels: Pages/SchematicPage.Layout.cs) -->
            <Grid x:Name="CanvasArea" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="2">
                <ed:SchematicCanvas x:Name="Canvas"/>
                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="340">
                    <TextBlock Text="Boş sayfa" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" FontWeight="Normal"/>
                    <TextBlock Style="{StaticResource Text.Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="17"
                               Text="Soldan bir parça seçip tuvale tıklayın. Bir pinden başlayıp başka bir pine tıklayarak kablo çekin."/>
                </StackPanel>
                <StackPanel x:Name="WorldBoards" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,170,0,0" MaxWidth="420" Visibility="Collapsed"/>
                <Border x:Name="ToastHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,12,12,0" Visibility="Collapsed"
                        Background="{DynamicResource B.Overlay}" BorderBrush="{DynamicResource B.BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="12,8"
                        Panel.ZIndex="5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource B.Danger}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToastText" Foreground="{DynamicResource B.Text}" Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="560" TextWrapping="Wrap"/>
                        <Button x:Name="ToastAction" Style="{StaticResource Btn.Ghost}" Content="Neden?" Margin="10,0,0,0" Padding="8,2" Visibility="Collapsed" Click="OnToastAction"/>
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>

            <!-- Library -->
            <Border x:Name="LibraryHost" Grid.Column="0" Background="{DynamicResource B.Base}" Panel.ZIndex="3">
                <DockPanel Margin="14,14,6,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,8,8">
                        <TextBox x:Name="SearchBox" Tag="Parça ara" Padding="28,4,8,4" TextChanged="OnSearchChanged"/>
                        <t:Icon Data="{StaticResource I.Search}" Size="14" Foreground="{DynamicResource B.TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,8,8">
                        <TextBlock x:Name="LibraryCount" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="10,0,2,0"/>
                        <ComboBox x:Name="CategoryBox" SelectionChanged="OnCategoryChanged"/>
                    </DockPanel>
                    <ListBox x:Name="PartList" SelectionChanged="OnPartPicked" PreviewMouseLeftButtonUp="OnPartListClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34" ToolTip="{Binding Description}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ed:SymbolPreview PresetId="{Binding Id}" Margin="2,5,10,5"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource B.Text}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource B.TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>


            <!-- Inspector -->
            <Border x:Name="InspectorHost" Grid.Column="4" Background="{DynamicResource B.Base}" Panel.ZIndex="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Inspector" Margin="18,16,16,16"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <GridSplitter x:Name="DockSplitter" Grid.Row="2" Height="7" Margin="0,-3" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Panel.ZIndex="5" ToolTip="Sürükleyerek alt bölmeyi büyütün / küçültün"/>
        <Border x:Name="DockLine" Grid.Row="2" Background="{DynamicResource B.Border}" IsHitTestVisible="False"/>

        <!-- ================= Dock: tabs the user can resize, hide, move to a side or into a window (Pages/SchematicPage.Layout.cs) ================= -->
        <DockPanel x:Name="BottomArea" Grid.Row="3">
            <StackPanel x:Name="DockTabs" DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,6,0,4">
                <RadioButton x:Name="DockScope" Style="{StaticResource Chip}" GroupName="schdock" Content="Osiloskop" IsChecked="True"/>
                <RadioButton x:Name="DockMeter" Style="{StaticResource Chip}" GroupName="schdock" Content="Multimetre" Margin="4,0,0,0"/>
                <RadioButton x:Name="DockDiag" Style="{StaticResource Chip}" GroupName="schdock" Margin="4,0,0,0"><TextBlock x:Name="DiagHeader" Text="Arıza tespiti"/></RadioButton>
                <RadioButton x:Name="DockMc" Style="{StaticResource Chip}" GroupName="schdock" Content="Monte Carlo" Margin="4,0,0,0"/>
                <RadioButton x:Name="DockPins" Style="{StaticResource Chip}" GroupName="schdock" Content="Kart pinleri" Margin="4,0,0,0"/>
                <RadioButton x:Name="DockSerial" Style="{StaticResource Chip}" GroupName="schdock" Content="Seri monitör" Margin="4,0,0,0"/>
                <RadioButton x:Name="DockLog" Style="{StaticResource Chip}" GroupName="schdock" Margin="4,0,0,0"><TextBlock x:Name="LogHeader" Text="Olaylar"/></RadioButton>
            </StackPanel>
            <Grid x:Name="DockHost">
            <Grid x:Name="ScopePane">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition x:Name="ScopePanelColumn" Width="318"/>
                </Grid.ColumnDefinitions>
                <sim:ScopeView x:Name="Scope" Margin="8,8,4,8"/>
                <Border x:Name="ScopePanelHost" Grid.Column="1" BorderBrush="{DynamicResource B.Border}" BorderThickness="1,0,0,0"/>
            </Grid>
            <Grid Visibility="Collapsed" x:Name="MeterPane">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MeterColumn" Width="470"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <sim:MultimeterView x:Name="Meter" Margin="6,4,0,4"/>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MeterPanel" Margin="16,10,16,10"/>
                </ScrollViewer>
            </Grid>
            <DockPanel Visibility="Collapsed" x:Name="DiagPane">
                <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4">
                    <Button DockPanel.Dock="Left" Content="Analiz et" Click="OnAnalyze" Padding="12,3"/>
                    <CheckBox x:Name="DiagAuto" DockPanel.Dock="Left" Style="{StaticResource Switch}" Content="Simülasyonda canlı" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DiagSummary" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DiagList" Margin="12,4,12,10"/>
                </ScrollViewer>
            </DockPanel>
            <Grid Visibility="Collapsed" x:Name="McPane">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="McPanel" Margin="14,8,10,10"/>
                </ScrollViewer>
                <DockPanel Grid.Column="1" Margin="4,8,10,8">
                    <TextBlock x:Name="McStats" DockPanel.Dock="Bottom" Style="{StaticResource Text.Mono}" FontSize="12" Margin="4,6,0,0" TextWrapping="Wrap"/>
                    <sim:HistogramView x:Name="Histogram"/>
                </DockPanel>
            </Grid>
            <ScrollViewer Visibility="Collapsed" x:Name="PinsPane" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PinPanel" Margin="14,10"/>
            </ScrollViewer>
            <DockPanel Visibility="Collapsed" x:Name="SerialPane" Margin="12,10">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Gönder" Margin="8,0,0,0" Click="OnSerialSend"/>
                    <Button DockPanel.Dock="Right" Content="Temizle" Margin="8,0,0,0" Click="OnSerialClear" Style="{StaticResource Btn.Ghost}"/>
                    <TextBlock x:Name="BaudText" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="SerialInput" Tag="Karta gönder (Enter)" KeyDown="OnSerialKey" FontFamily="{StaticResource F.Mono}"/>
                </DockPanel>
                <TextBox x:Name="SerialOutput" IsReadOnly="True" FontFamily="{StaticResource F.Mono}" FontSize="12.5" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="{DynamicResource B.Canvas}"
                         Foreground="{DynamicResource B.Text}" Padding="10,8"/>
            </DockPanel>
            <ListBox Visibility="Collapsed" x:Name="LogList" Margin="10,6">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TimeText}" Width="84" Foreground="{DynamicResource B.TextMuted}" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
                            <TextBlock Text="{Binding KindText}" Width="64" Foreground="{DynamicResource B.TextSecondary}" FontSize="12"/>
                            <TextBlock Text="{Binding Device}" Width="96" Foreground="{DynamicResource B.Text}" FontSize="12"/>
                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource B.TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
