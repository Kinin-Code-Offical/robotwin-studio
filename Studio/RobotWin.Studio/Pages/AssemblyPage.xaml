<UserControl x:Class="RobotWin.Studio.Pages.AssemblyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:RobotWin.Studio.Theme"
             xmlns:fx="clr-namespace:RobotWin.Studio.Assembly3D"
             Background="{StaticResource B.Base}" Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{StaticResource B.Base}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RunButton" Style="{StaticResource Btn.Primary}" Padding="12,0" MinHeight="30" Click="OnRun">
                        <StackPanel Orientation="Horizontal">
                            <t:Icon x:Name="RunIcon" Data="{StaticResource I.Play}" Size="14" Foreground="{StaticResource B.OnPrimary}"/>
                            <TextBlock x:Name="RunText" Text="Başlat" Margin="7,0,0,0" Foreground="{StaticResource B.OnPrimary}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" Margin="6,0,0,0" ToolTip="Durdur" Click="OnStop"><t:Icon Data="{StaticResource I.Stop}"/></Button>
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="Aracı başlangıç noktasına al (R)" Click="OnResetVehicle"><t:Icon Data="{StaticResource I.Reset}"/></Button>
                    <Border Width="1" Height="22" Background="{StaticResource B.Border}" Margin="12,0"/>
                    <TextBlock Text="Kamera" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="CamFollow" Style="{StaticResource Chip}" Content="Takip" GroupName="cam" IsChecked="True" Margin="0,0,4,0" Click="OnCamera"/>
                    <RadioButton x:Name="CamFree" Style="{StaticResource Chip}" Content="Serbest" GroupName="cam" Margin="0,0,4,0" Click="OnCamera"/>
                    <RadioButton x:Name="CamTop" Style="{StaticResource Chip}" Content="Üstten" GroupName="cam" Margin="0,0,4,0" Click="OnCamera"/>
                    <RadioButton x:Name="CamFpv" Style="{StaticResource Chip}" Content="Araç üstü" GroupName="cam" Margin="0,0,4,0" Click="OnCamera"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SimStatus" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Margin="0,0,6,0" Click="OnSaveRecording" ToolTip="Bu koşuyu .rwsim kaydı olarak sakla (yörünge, olaylar, kanallar)">
                        <StackPanel Orientation="Horizontal"><t:Icon Data="{StaticResource I.Save}" Size="14"/><TextBlock Text="Kaydı kaydet" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                    <Button Click="OnAutoConfigure" ToolTip="Şematikteki motor, sensör ve kartlardan montajı yeniden kur">
                        <StackPanel Orientation="Horizontal"><t:Icon Data="{StaticResource I.Place}" Size="14"/><TextBlock Text="Otomatik montaj" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="316"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="ViewHost" Background="#0B0B0D" ClipToBounds="True">
                <Viewport3D x:Name="View" ClipToBounds="True"/>
                <fx:EffectsLayer x:Name="Effects"/>

                <!-- HUD -->
                <Border x:Name="Hud" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="12,10"
                        Background="#CC111113" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock x:Name="HudTitle" Style="{StaticResource Text.Overline}" Margin="0,0,0,6"/>
                        <Grid x:Name="HudGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Toasts" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Width="300" IsHitTestVisible="False"/>

                <Border x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,18" MaxWidth="460"
                        Background="#E6111113" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Montaj yok" Style="{StaticResource Text.Subtitle}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource B.TextSecondary}" Margin="0,6,0,12"
                                   Text="Devreye iki motor eklerseniz robot araba, bir uçuş kontrolcüsü ve dört motor eklerseniz quadcopter olarak monte edilir. Hazır şablonlar Başla sayfasında."/>
                        <Button HorizontalAlignment="Left" Click="OnAutoConfigure" Content="Devreden montaj oluştur"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ControlsHint" Style="{StaticResource Text.Caption}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,10"/>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource B.Border}"/>
            <Border Grid.Column="2" Background="{StaticResource B.Base}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Panel" Margin="16,14"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
