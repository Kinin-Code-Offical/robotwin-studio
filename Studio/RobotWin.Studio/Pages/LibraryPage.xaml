<UserControl x:Class="RobotWin.Studio.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:RobotWin.Studio.Theme"
             xmlns:ed="clr-namespace:RobotWin.Studio.Editor"
             xmlns:pcb="clr-namespace:RobotWin.Studio.Pcb"
             Background="{DynamicResource B.Base}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="28,22,20,0">
            <StackPanel DockPanel.Dock="Top">
                <Grid>
                    <TextBlock Text="Bileşen kütüphanesi" Style="{StaticResource Text.Title}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- [libs] part creator, external libraries, library manager -->
                        <Button Style="{StaticResource Btn.Icon}" Click="OnImport" ToolTip=".rwpart parça veya .rwlib kütüphane dosyası ekle"><t:Icon Data="{StaticResource I.Import}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" Margin="2,0,0,0" Click="OnExternalMenu" ToolTip="KiCad, SPICE, Fritzing ve Arduino kütüphaneleri (önizleme ve eşlemeyle) ya da toplu içe aktarma"><t:Icon Data="{StaticResource I.Library}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" Margin="2,0,0,0" Click="OnOpenManager" ToolTip="Kurulu kütüphaneler: sürüm, aç/kapat, güncelle, kaldır, çakışmalar, arama"><t:Icon Data="{StaticResource I.Layers}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" Margin="2,0,0,0" Click="OnExportLibrary" ToolTip="Kendi parçalarınızı tek .rwlib dosyasında paylaşın"><t:Icon Data="{StaticResource I.Export}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Primary}" Padding="12,0" MinHeight="28" MinWidth="44" Margin="8,0,0,0" Click="OnCreatePart" ToolTip="Kendi parçanız: bacaklar, sembol, kılıf, simülasyon modeli, parametreler, 3B model"><t:Icon Data="{StaticResource I.Plus}" Size="16" Foreground="{DynamicResource B.OnPrimary}"/></Button>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Body}" Margin="0,4,0,14"/>
                <Grid Margin="0,0,0,10" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" Width="520" Tag="Parça numarası, isim veya açıklama…" Padding="30,4,8,4" TextChanged="OnSearch"/>
                    <t:Icon Data="{StaticResource I.Search}" Size="14" Foreground="{DynamicResource B.TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                </Grid>
                <WrapPanel x:Name="Categories" Margin="0,0,0,8"/>
            </StackPanel>
            <ListBox x:Name="PartGrid" SelectionChanged="OnPick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Margin" Value="0,0,8,8"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{DynamicResource Lib.CardWidth}" Height="140" CornerRadius="6" Background="Transparent" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" Padding="12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource B.Text}" FontSize="{StaticResource T.Body}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource B.TextMuted}" FontSize="12"/>
                                </StackPanel>
                                <ed:SymbolPreview PresetId="{Binding Id}" Margin="10,4,10,10"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Background="{DynamicResource B.Border}"/>
        <Border Grid.Column="2" Background="{DynamicResource B.Base}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Detail" Margin="22,22,22,22"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
