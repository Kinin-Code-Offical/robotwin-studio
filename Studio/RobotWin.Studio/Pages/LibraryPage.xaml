<UserControl x:Class="RobotWin.Studio.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:RobotWin.Studio.Theme"
             xmlns:ed="clr-namespace:RobotWin.Studio.Editor"
             xmlns:pcb="clr-namespace:RobotWin.Studio.Pcb"
             Background="{StaticResource B.Base}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="28,22,20,0">
            <StackPanel DockPanel.Dock="Top">
                <Grid>
                    <TextBlock Text="Bileşen kütüphanesi" Style="{StaticResource Text.Title}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="İçe aktar…" Click="OnImport" ToolTip=".rwpart parça veya .rwlib kütüphane dosyası ekle"/>
                        <Button Content="KiCad dosyası…" Margin="6,0,0,0" Click="OnImportKiCadFiles" ToolTip="KiCad sembol (.kicad_sym) ve footprint (.kicad_mod) dosyalarından parça oluştur; simülasyon modeli otomatik eşlenir"/>
                        <Button Content="KiCad .pretty klasörü…" Margin="6,0,0,0" Click="OnImportKiCadFolder" ToolTip="Bütün bir KiCad footprint kütüphanesini (.pretty klasörü) içe aktar"/>
                        <Button Content="Kütüphanemi dışa aktar" Margin="6,0,0,0" Click="OnExportLibrary" ToolTip="Kendi parçalarınızı tek .rwlib dosyasında paylaşın"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Body}" Margin="0,4,0,14"/>
                <Grid Margin="0,0,0,10" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" Width="520" Tag="Parça numarası, isim veya açıklama…" Padding="30,4,8,4" TextChanged="OnSearch"/>
                    <t:Icon Data="{StaticResource I.Search}" Size="14" Foreground="{StaticResource B.TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                </Grid>
                <WrapPanel x:Name="Categories" Margin="0,0,0,8"/>
            </StackPanel>
            <ListBox x:Name="PartGrid" SelectionChanged="OnPick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Margin" Value="0,0,8,8"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="168" Height="140" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource B.Border}" BorderThickness="1" Padding="12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource B.Text}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource B.TextMuted}" FontSize="11"/>
                                </StackPanel>
                                <ed:SymbolPreview PresetId="{Binding Id}" Margin="10,4,10,10"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Background="{StaticResource B.Border}"/>
        <Border Grid.Column="2" Background="{StaticResource B.Base}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Detail" Margin="22,22,22,22"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
