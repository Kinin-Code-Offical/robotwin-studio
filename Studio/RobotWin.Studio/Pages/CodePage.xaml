<UserControl x:Class="RobotWin.Studio.Pages.CodePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:RobotWin.Studio.Theme"
             xmlns:ed="clr-namespace:RobotWin.Studio.Editor"
             xmlns:fw="clr-namespace:RobotWin.Studio.Firmware"
             Background="{DynamicResource B.Base}">
    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition x:Name="DockLineRow" Height="1"/>
            <RowDefinition x:Name="DockRow" Height="230" MinHeight="36"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{DynamicResource B.Base}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <t:Icon Data="{StaticResource I.Chip}" Size="16" Foreground="{DynamicResource B.TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="TargetBox" Width="260" SelectionChanged="OnTargetChanged"
                              ToolTip="Kodun yükleneceği kart: projedeki ya da açık dünyadaki her Arduino Uno, Nano ve ESP32"/>
                    <Button x:Name="ModeBadge" Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0" Padding="8,0" MinHeight="24" VerticalAlignment="Center" Click="OnModeBadge">
                        <TextBlock x:Name="ModeBadgeText" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource B.Text}"/>
                    </Button>
                    <t:Icon Data="{StaticResource I.Library}" Size="16" Foreground="{DynamicResource B.TextMuted}" VerticalAlignment="Center" Margin="14,0,8,0"/>
                    <ComboBox x:Name="TemplateBox" Width="170" SelectionChanged="OnTemplate" ToolTip="Örnek kod: seçilen örnek bu klasöre yazılır"/>
                    <Border Width="1" Height="22" Background="{DynamicResource B.Border}" Margin="12,0"/>
                    <Button x:Name="BuildButton" Style="{StaticResource Btn.Icon}" Click="OnBuild" ToolTip="Derle (F7)"><t:Icon Data="{StaticResource I.Build}" Size="16"/></Button>
                    <Button x:Name="UploadButton" Style="{StaticResource Btn.Primary}" Padding="14,0" MinHeight="28" MinWidth="44" Margin="6,0,0,0" Click="OnUpload" ToolTip="Bu klasörü seçili karta yükle, derle ve çalıştır (F5)">
                        <t:Icon Data="{StaticResource I.Play}" Size="13" Filled="True" Foreground="{DynamicResource B.OnPrimary}"/>
                    </Button>
                    <Button x:Name="HardwareButton" Style="{StaticResource Btn.Icon}" Margin="6,0,0,0" Click="OnHardware" Visibility="Collapsed"
                            ToolTip="Gerçek ESP32 için: Espressif'in araç zinciriyle derle, USB ile karta yükle ya da imajı dışa aktar"><t:Icon Data="{StaticResource I.Export}" Size="16"/></Button>
                    <Button Style="{StaticResource Btn.Icon}" Margin="6,0,0,0" ToolTip="Simülasyonu durdur" Click="OnStop"><t:Icon Data="{StaticResource I.Stop}" Size="16"/></Button>
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="Kartı resetle" Click="OnReset"><t:Icon Data="{StaticResource I.Reset}" Size="16"/></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="BuildStatus" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- [dock] explorer | editor | (right dock): the explorer and the bottom tabs move, minimize and tear off (Shell/DockManager.cs) -->
        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="ExplorerPane" Background="{DynamicResource B.Base}">
                <DockPanel DockPanel.Dock="Top" Margin="12,8,6,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Yeni dosya (.ino, .h, .cpp …)" Click="OnNewFile"><t:Icon Data="{StaticResource I.Plus}" Size="14"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Yeni kod klasörü" Click="OnNewFolder"><t:Icon Data="{StaticResource I.Folder}" Size="14"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Diskten klasör aç (Arduino çizim klasörü ya da herhangi bir kod klasörü)" Click="OnOpenFolder"><t:Icon Data="{StaticResource I.Import}" Size="14"/></Button>
                        <Button x:Name="MoreButton" Style="{StaticResource Btn.Icon}" ToolTip="İçe aktar, diske kaydet, zip, yeniden adlandır, sil" Click="OnMore"><t:Icon Data="{StaticResource I.More}" Size="14"/></Button>
                    </StackPanel>
                </DockPanel>
                <TreeView x:Name="Explorer" BorderThickness="0" Background="Transparent" Margin="4,0,0,6"
                          SelectedItemChanged="OnExplorerPick" MouseRightButtonUp="OnExplorerMenu" AllowDrop="True" Drop="OnExplorerDrop">
                    <TreeView.Resources>
                        <!-- The selected file: the theme's soft accent, not the system's white. -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource C.AccentSoft}"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource C.AccentSoft}"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource C.Text}"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource C.Text}"/>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1" Padding="12,5">
                    <TextBlock x:Name="FileTitle" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
                </Border>
                <!-- [debug] breakpoints and steps: the circuit, the world and the code stop at one instant -->
                <Border x:Name="DebugBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource B.Canvas}"
                        BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1" Padding="10,4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="DebugContinue" Style="{StaticResource Btn.Icon}" Click="OnDebugContinue" ToolTip="Programı (ve devreyi, dünyayı) sürdür (F5)"><t:Icon Data="{StaticResource I.Play}" Size="14"/></Button>
                            <Button x:Name="DebugBreak" Style="{StaticResource Btn.Icon}" Click="OnDebugBreak" ToolTip="Kodunuzun bir sonraki satırında dur"><t:Icon Data="{StaticResource I.Pause}" Size="14"/></Button>
                            <Button x:Name="DebugOver" Style="{StaticResource Btn.Icon}" Click="OnDebugOver" ToolTip="Bir sonraki satıra geç; çağrılan fonksiyonlar içinde durmadan çalışır (F10)"><t:Icon Data="{StaticResource I.Step}" Size="14"/></Button>
                            <Button x:Name="DebugInto" Style="{StaticResource Btn.Icon}" Click="OnDebugInto" ToolTip="Çağrılan fonksiyonun içine gir (F11)"><t:Icon Data="{StaticResource I.StepInto}" Size="16"/></Button>
                            <Button x:Name="DebugOut" Style="{StaticResource Btn.Icon}" Click="OnDebugOut" ToolTip="İçinde bulunulan fonksiyon dönene kadar çalış (Shift+F11)"><t:Icon Data="{StaticResource I.StepOut}" Size="16"/></Button>
                            <Border Width="1" Height="18" Background="{DynamicResource B.Border}" Margin="8,0"/>
                            <Button x:Name="DebugClear" Style="{StaticResource Btn.Icon}" Click="OnDebugClear" ToolTip="Bu kartın bütün kesme noktalarını kaldır"><t:Icon Data="{StaticResource I.BreakClear}" Size="16"/></Button>
                        </StackPanel>
                        <Ellipse x:Name="DebugDot" Width="9" Height="9" Fill="{DynamicResource B.Danger}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DebugState" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <ed:CodeEditor x:Name="Editor"/>
                    <Border x:Name="NoBoard" Background="{DynamicResource B.Scrim}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                            <TextBlock Text="Bir kart ya da kod klasörü seçin" Style="{StaticResource Text.Subtitle}"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource B.TextSecondary}" Margin="0,6,0,12"
                                       Text="Soldaki Kartlar bölümünde projedeki ve açık dünyadaki her Arduino Uno, Nano ve ESP32'nin kendi kodu var. Kod klasörlerim'de diskte çalışırsınız: yeni klasör açın ya da var olan bir Arduino çizim klasörünü açın, istediğiniz karta yükleyin."/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Yeni kod klasörü" Click="OnNewFolder"/>
                                <Button Content="Klasör aç…" Margin="8,0,0,0" Click="OnOpenFolder"/>
                                <Button Content="Devreye Arduino Uno ekle" Margin="8,0,0,0" Click="OnAddUno"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>

        <GridSplitter x:Name="DockSplitter" Grid.Row="2" Height="7" Margin="0,-3" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Panel.ZIndex="5" ToolTip="Sürükleyerek alt bölmeyi büyütün / küçültün"/>
        <Border x:Name="DockLine" Grid.Row="2" Background="{DynamicResource B.Border}" IsHitTestVisible="False"/>

        <DockPanel x:Name="BottomArea" Grid.Row="3">
            <StackPanel x:Name="DockTabs" DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,6,0,4">
                <RadioButton x:Name="DockBuild" Style="{StaticResource Chip}" GroupName="codedock" Content="Derleyici" IsChecked="True"/>
                <RadioButton x:Name="DockSerial" Style="{StaticResource Chip}" GroupName="codedock" Content="Seri monitör" Margin="4,0,0,0"/>
                <RadioButton x:Name="DockVars" Style="{StaticResource Chip}" GroupName="codedock" Content="Değişkenler" Margin="4,0,0,0"/>
                <RadioButton x:Name="DockRegs" Style="{StaticResource Chip}" GroupName="codedock" Content="Yazmaçlar" Margin="4,0,0,0"/>
                <RadioButton x:Name="DockTimeline" Style="{StaticResource Chip}" GroupName="codedock" Content="Zaman çizelgesi" Margin="4,0,0,0"/>
            </StackPanel>
            <Grid x:Name="DockHost">
                <Grid x:Name="BuildPane">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="Problems" MouseDoubleClick="OnProblemPick" SelectionChanged="OnProblemPick" Margin="6"/>
                    <Border Grid.Column="1" Background="{DynamicResource B.Border}"/>
                    <TextBox x:Name="BuildLog" Grid.Column="2" IsReadOnly="True" FontFamily="{StaticResource F.Mono}" FontSize="12"
                             TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Margin="6"/>
                </Grid>
                <DockPanel x:Name="SerialPane" Visibility="Collapsed" Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Gönder" Margin="8,0,0,0" Click="OnSerialSend"/>
                        <TextBox x:Name="SerialInput" KeyDown="OnSerialKey" Tag="Karta gönder (Enter)"/>
                    </DockPanel>
                    <TextBox x:Name="SerialView" IsReadOnly="True" FontFamily="{StaticResource F.Mono}" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0"/>
                </DockPanel>
                <DockPanel x:Name="VariablesPane" Visibility="Collapsed" Margin="10,6,10,6">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ad" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="1" Text="Değer" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="2" Text="Tür" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="3" Text="Adres" Style="{StaticResource Text.Caption}"/>
                    </Grid>
                    <TextBlock x:Name="VariablesNote" DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="VariablesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="320"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource F.Mono}" FontSize="{StaticResource T.Body}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Where}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource F.Mono}" FontSize="{StaticResource T.Body}" Foreground="{Binding ValueBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Type}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Address}" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{DynamicResource B.TextSecondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <DockPanel x:Name="RegistersPane" Visibility="Collapsed" Margin="10,6,10,6">
                    <TextBlock x:Name="RegistersNote" DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <ScrollViewer DockPanel.Dock="Left" Width="400" Margin="0,0,24,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="CoreLine" FontFamily="{StaticResource F.Mono}" FontSize="{StaticResource T.Body}"/>
                            <TextBlock x:Name="CycleLine" Style="{StaticResource Text.Caption}" Margin="0,2,0,8"/>
                            <ItemsControl x:Name="GeneralRegisters">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value}" Foreground="{Binding ValueBrush}" ToolTip="{Binding Tip}" FontFamily="{StaticResource F.Mono}" FontSize="12" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Yazmaç" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="1" Text="Değer" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="2" Text="İkili" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="3" Text="Adres" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="4" Text="Açık bitler" Style="{StaticResource Text.Caption}"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RegistersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="{Binding Spacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontWeight="{Binding Weight}" FontFamily="{StaticResource F.Mono}" FontSize="{StaticResource T.Body}" ToolTip="{Binding Tip}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontFamily="{StaticResource F.Mono}" FontSize="{StaticResource T.Body}" ToolTip="{Binding Tip}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Binary}" Foreground="{Binding ValueBrush}" FontFamily="{StaticResource F.Mono}" FontSize="{StaticResource T.Body}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Address}" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{DynamicResource B.TextSecondary}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Flags}" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{DynamicResource B.TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Flags}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <DockPanel x:Name="TimelinePane" Visibility="Collapsed" Margin="10,6,10,6">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="8,0" MinHeight="22" Margin="8,0,0,0" Click="OnTimelineToScope"
                                ToolTip="Zaman çizelgesi osiloskobun gösterdiği saniyeleri gösterir; birinde gezdiğiniz an öbüründe kesikli çizgiyle işaretlenir">
                            <TextBlock Text="Osiloskopla eşle" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource B.Text}"/>
                        </Button>
                        <TextBlock x:Name="TimelineNote" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <fw:TimelineView x:Name="Timeline" MinHeight="120"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>

        <Border Grid.Row="4" Background="{DynamicResource B.Canvas}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="CaretText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TargetText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
