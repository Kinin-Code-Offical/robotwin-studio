<UserControl x:Class="RobotWin.Studio.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource B.Base}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="20,30,12,20">
            <TextBlock DockPanel.Dock="Top" Text="Ayarlar" Style="{StaticResource Text.Title}" Margin="8,0,0,16"/>
            <Button DockPanel.Dock="Bottom" Content="Varsayılanlara dön" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Click="OnReset" Margin="0,12,0,0"/>
            <StackPanel x:Name="SectionNav"/>
        </DockPanel>
        <Border Grid.Column="1" Background="{StaticResource B.Border}"/>

        <ScrollViewer x:Name="Scroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,30,36,40" MaxWidth="780" HorizontalAlignment="Left">
                <StackPanel x:Name="Sections"/>

                <Border x:Name="FileTypesCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Dosya türleri" Style="{StaticResource Text.Subtitle}"/>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,12"
                                   Text="RobotWin kendi paket biçimlerini kullanır. Hepsi sürümlü ZIP kapsayıcılarıdır; içlerinde manifest.json bulunur."/>
                        <StackPanel x:Name="FileTypes" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AssocButton" Content="Windows'ta bu uygulamayla aç" Click="OnRegisterFiles"/>
                            <Button x:Name="UnassocButton" Content="İlişkilendirmeyi kaldır" Margin="8,0,0,0" Style="{StaticResource Btn.Ghost}" Click="OnUnregisterFiles"/>
                        </StackPanel>
                        <TextBlock x:Name="AssocStatus" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="AboutCard" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="AboutLogo" Width="72" Height="72" Margin="0,0,18,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="RobotWin Studio 2.0" Style="{StaticResource Text.Subtitle}"/>
                            <TextBlock x:Name="AboutText" Style="{StaticResource Text.Body}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Logoyu dışa aktar (PNG + ICO)" Click="OnExportLogo"/>
                                <Button Content="Ayar ve günlük klasörünü aç" Margin="8,0,0,0" Style="{StaticResource Btn.Ghost}" Click="OnOpenDataFolder"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
