<UserControl x:Class="RobotWin.Studio.Pages.WorldPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:RobotWin.Studio.Theme"
             xmlns:w="clr-namespace:RobotWin.Studio.World"
             Background="{StaticResource B.Base}">
    <Grid>
        <!-- Shown when the active tab is not a world -->
        <Grid x:Name="NoWorld" Visibility="Collapsed" Background="{StaticResource B.Base}" Panel.ZIndex="5">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <t:Icon Data="{StaticResource I.World}" Size="44" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Left"/>
                <TextBlock Text="Dünya: her şeyi bir araya getirin" Style="{StaticResource Text.Title}" Margin="0,16,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource B.TextSecondary}"
                           Text="Bir dünyaya istediğiniz kadar kendi tasarladığınız kartı, servoları, motorları, pilleri, sensörleri, ekranları, mekanik parçaları ve 3D modelleri koyun; pinlerini kablolarla, gövdelerini bağlantılarla birleştirin. Hepsi tek bir devre ve tek bir fizik ortamı olarak birlikte simüle edilir."/>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Style="{StaticResource Btn.Primary}" Content="Yeni dünya" Padding="16,0" Click="OnNewWorld"/>
                    <Button Content="Bu devreyi yeni bir dünyaya koy" Margin="8,0,0,0" Padding="14,0" Click="OnWorldFromDesign"/>
                    <Button Content="Aç…" Margin="8,0,0,0" Padding="14,0" Click="OnOpenWorld"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition x:Name="DockRow" Height="190" MinHeight="36"/>
            </Grid.RowDefinitions>

            <!-- ================= Toolbar ================= -->
            <Border Grid.Row="0" Background="{StaticResource B.Base}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="ToolSelect" Style="{StaticResource Toggle.Tool}" ToolTip="Seç ve taşı (Esc)" Click="OnTool" Tag="Select" IsChecked="True">
                            <t:Icon Data="{StaticResource I.Pointer}" Size="16"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolCable" Style="{StaticResource Toggle.Tool}" ToolTip="Kablo çek: iki pine tıklayın (K)" Click="OnTool" Tag="Cable" Margin="2,0">
                            <t:Icon Data="{StaticResource I.Cable}" Size="16"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolJoint" Style="{StaticResource Toggle.Tool}" ToolTip="Bağla: seçili nesneyi başka bir nesneye / servo koluna / motor miline tak (B)" Click="OnTool" Tag="Joint">
                            <t:Icon Data="{StaticResource I.Joint}" Size="16"/>
                        </ToggleButton>
                        <Border Width="1" Height="16" Background="{StaticResource B.Border}" Margin="10,0"/>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="15° döndür (R, Shift+R ters)" Click="OnRotate"><t:Icon Data="{StaticResource I.Rotate}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Çoğalt (Ctrl+D)" Click="OnDuplicate"><t:Icon Data="{StaticResource I.Plus}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Sil (Del)" Click="OnDelete"><t:Icon Data="{StaticResource I.Delete}" Size="16"/></Button>
                        <Border Width="1" Height="16" Background="{StaticResource B.Border}" Margin="10,0"/>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Geri al (Ctrl+Z)" Click="OnUndo"><t:Icon Data="{StaticResource I.Undo}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Yinele (Ctrl+Y)" Click="OnRedo"><t:Icon Data="{StaticResource I.Redo}" Size="16"/></Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="RunButton" Style="{StaticResource Btn.Primary}" Padding="12,0" MinHeight="28" Click="OnRun" ToolTip="Dünyayı simüle et / duraklat (F5)">
                            <StackPanel Orientation="Horizontal">
                                <t:Icon x:Name="RunIcon" Data="{StaticResource I.Play}" Size="12" Filled="True" Foreground="{StaticResource B.OnPrimary}"/>
                                <TextBlock x:Name="RunText" Text="Dünyayı çalıştır" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource B.OnPrimary}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="10 ms ilerlet" Click="OnStep" Margin="6,0,0,0"><t:Icon Data="{StaticResource I.Step}" Size="14"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Durdur ve başa dön (Shift+F5)" Click="OnStop"><t:Icon Data="{StaticResource I.Stop}" Size="14"/></Button>
                        <ComboBox x:Name="SpeedBox" Width="130" Margin="6,0,0,0" SelectionChanged="OnSpeed" ToolTip="Simülasyon hızı">
                            <ComboBoxItem Content="0.01×" Tag="0.01"/>
                            <ComboBoxItem Content="0.1×" Tag="0.1"/>
                            <ComboBoxItem Content="0.5×" Tag="0.5"/>
                            <ComboBoxItem Content="Gerçek zaman" Tag="1" IsSelected="True"/>
                            <ComboBoxItem Content="5×" Tag="5"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="SimStatus" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ToggleButton x:Name="FollowToggle" Style="{StaticResource Toggle.Tool}" ToolTip="Kamera seçili nesneyi takip etsin (T)" Click="OnFollow"><t:Icon Data="{StaticResource I.Eye}" Size="16"/></ToggleButton>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Üstten görünüm" Click="OnTop"><t:Icon Data="{StaticResource I.Layers}" Size="16"/></Button>
                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Hepsini sığdır (F)" Click="OnFit"><t:Icon Data="{StaticResource I.ZoomFit}" Size="16"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Main area ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="268" MinWidth="200"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="300" MinWidth="220"/>
                </Grid.ColumnDefinitions>

                <!-- Palette -->
                <DockPanel Grid.Column="0" Margin="12,12,6,0">
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="TabScene" Style="{StaticResource Chip}" Content="Sahne" GroupName="pal" IsChecked="True" Margin="0,0,0,4" Click="OnPaletteTab" ToolTip="Dünyadaki her şey: neyin neye bağlı olduğu, durumları"/>
                        <RadioButton x:Name="TabBoards" Style="{StaticResource Chip}" Content="Kartlar" GroupName="pal" Margin="4,0,0,4" Click="OnPaletteTab"/>
                        <RadioButton x:Name="TabParts" Style="{StaticResource Chip}" Content="Parçalar" GroupName="pal" Margin="4,0,4,4" Click="OnPaletteTab"/>
                        <RadioButton x:Name="TabMech" Style="{StaticResource Chip}" Content="Mekanik" GroupName="pal" Margin="0,0,0,4" Click="OnPaletteTab"/>
                        <RadioButton x:Name="TabEnv" Style="{StaticResource Chip}" Content="Ortam" GroupName="pal" Margin="4,0,0,4" Click="OnPaletteTab"/>
                        <!-- [sdk] Pages/WorldPage.Sdk.cs -->
                        <RadioButton x:Name="TabSdk" Style="{StaticResource Chip}" Content="Betikler" GroupName="pal" Margin="4,0,0,4" Click="OnPaletteTab" ToolTip="Betikler ve eklentiler: kendi fizik kodunuz, ifadeler, kuvvet alanları"/>
                        <!-- [terrain] terrain / world editor (Pages/WorldPage.Terrain.cs) -->
                        <RadioButton x:Name="TabTerrain" Style="{StaticResource Chip}" Content="Arazi" GroupName="pal" Margin="4,0,0,4" Click="OnPaletteTab" ToolTip="Arazi düzenleyici: şekillendir, boya, yol, nesneler (Unity Terrain gibi)"/>
                    </WrapPanel>
                    <Grid x:Name="SearchRow" DockPanel.Dock="Top" Margin="0,0,6,8" Visibility="Collapsed">
                        <TextBox x:Name="SearchBox" Tag="Parça ara (servo, motor, pil, sensör…)" Padding="28,4,8,4" TextChanged="OnSearch"/>
                        <t:Icon Data="{StaticResource I.Search}" Size="14" Foreground="{StaticResource B.TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Palette" Margin="0,0,6,12"/>
                    </ScrollViewer>
                </DockPanel>
                <Border Grid.Column="1" Background="{StaticResource B.Border}"/>

                <w:WorldScene x:Name="Scene" Grid.Column="2"/>

                <Border Grid.Column="3" Background="{StaticResource B.Border}"/>
                <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Inspector" Margin="14,12,14,16"/>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Row="2" Height="5" Margin="0,-2" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
            <Border Grid.Row="2" Background="{StaticResource B.Border}" IsHitTestVisible="False"/>

            <!-- ================= Bottom dock ================= -->
            <DockPanel Grid.Row="3">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,6,0,4">
                    <RadioButton x:Name="DockLog" Style="{StaticResource Chip}" Content="Olaylar" GroupName="dock" IsChecked="True" Click="OnDockTab"/>
                    <RadioButton x:Name="DockSerial" Style="{StaticResource Chip}" Content="Seri monitör" GroupName="dock" Margin="4,0" Click="OnDockTab"/>
                    <RadioButton x:Name="DockCables" Style="{StaticResource Chip}" Content="Kablolar ve ölçümler" GroupName="dock" Click="OnDockTab"/>
                    <RadioButton x:Name="DockRf" Style="{StaticResource Chip}" Content="RF" GroupName="dock" Margin="4,0,0,0" Click="OnDockTab" ToolTip="Radyo: cihazlar, RSSI, kanal, paket/s (World/RadioOverlay)"/>
                </StackPanel>
                <Grid Margin="12,0,12,8">
                    <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource F.Mono}" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Time, Mode=OneWay, StringFormat={}{0:0.000} s}" Foreground="{StaticResource B.TextMuted}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding Device, Mode=OneWay}" Foreground="{StaticResource B.TextSecondary}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding Message, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel x:Name="SerialPanel" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Gönder" Margin="6,0,0,0" Padding="12,0" Click="OnSerialSend"/>
                            <TextBox x:Name="SerialInput" Tag="Kartlara gönder (Enter)" KeyDown="OnSerialKey"/>
                        </DockPanel>
                        <TextBox x:Name="SerialView" IsReadOnly="True" FontFamily="{StaticResource F.Mono}" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0"/>
                    </DockPanel>
                    <ScrollViewer x:Name="CablePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CableTable"/>
                    </ScrollViewer>
                    <!-- [radio] RF panel (Pages/WorldPage.Radio.cs) -->
                    <ScrollViewer x:Name="RfPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RfTable"/>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
