<UserControl x:Class="RobotWin.Studio.Pages.ModelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:RobotWin.Studio.Theme"
             Background="{DynamicResource B.Base}">
    <UserControl.Resources>
        <!-- Modeller icons (24×24 line icons in the app's icon style). -->
        <Geometry x:Key="M.Scale">M4,20 L20,4 M14,4 H20 V10 M10,20 H4 V14</Geometry>
        <Geometry x:Key="M.Ruler">M3,16 L16,3 L21,8 L8,21 Z M7.5,11.5 L9.5,13.5 M10.5,8.5 L12.5,10.5 M13.5,5.5 L15.5,7.5</Geometry>
        <Geometry x:Key="M.Box">M12,3 L20,7.5 V16.5 L12,21 L4,16.5 V7.5 Z M4,7.5 L12,12 L20,7.5 M12,12 V21</Geometry>
        <Geometry x:Key="M.Cylinder">M5,6 A7,2.5 0 1 0 19,6 A7,2.5 0 1 0 5,6 M5,6 V18 A7,2.5 0 0 0 19,18 V6</Geometry>
        <Geometry x:Key="M.Cone">M12,3 L5,18 A7,2.5 0 0 0 19,18 Z</Geometry>
        <Geometry x:Key="M.Sphere">M12,3 A9,9 0 1 1 11.99,3 M3,12 A9,3 0 0 0 21,12</Geometry>
        <Geometry x:Key="M.Torus">M12,3 A9,9 0 1 1 11.99,3 M12,8.5 A3.5,3.5 0 1 1 11.99,8.5</Geometry>
        <Geometry x:Key="M.Tube">M5,6 A7,2.5 0 1 0 19,6 A7,2.5 0 1 0 5,6 M9,6 A3,1 0 1 0 15,6 A3,1 0 1 0 9,6 M5,6 V18 A7,2.5 0 0 0 19,18 V6</Geometry>
        <Geometry x:Key="M.Wedge">M3,18 H21 L3,7 Z M3,18 L7,15 H21 M7,15 L3,7</Geometry>
        <Geometry x:Key="M.Plate">M3,10 L12,6 L21,10 L12,14 Z M3,10 V12.5 L12,16.5 L21,12.5 V10 M10,10 A1.6,0.8 0 1 0 10.01,10 M15,10 A1.6,0.8 0 1 0 15.01,10</Geometry>
        <Geometry x:Key="M.Extrude">M5,14 V8 L9,5 H19 V11 L15,14 Z M5,8 H15 V14 M15,8 L19,5 M12,19 V16 M10,17.5 L12,19.5 L14,17.5</Geometry>
        <Geometry x:Key="M.Revolve">M12,3 V21 M12,5 C17,5 15,10 18,12 C15,14 17,19 12,19 M5,9 A7,2.4 0 0 0 19,9</Geometry>
        <Geometry x:Key="M.Union">M4,6 H14 V10 H20 V20 H10 V16 H4 Z</Geometry>
        <Geometry x:Key="M.Difference">M4,4 H15 V9 H9 V15 H4 Z M11,11 H20 V20 H11 Z</Geometry>
        <Geometry x:Key="M.Intersect">M4,4 H14 V14 H4 Z M10,10 H20 V20 H10 Z M10,10 H14 V14 H10 Z</Geometry>
        <Geometry x:Key="M.Edit">M4,20 L5,15 L15,5 L19,9 L9,19 Z M13,7 L17,11 M4,20 L9,19</Geometry>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ================= Toolbar ================= -->
        <Border Grid.Row="0" Background="{DynamicResource B.Base}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="Yeni model (Ctrl+N)" Click="OnNew"><t:Icon Data="{StaticResource M.Box}" Size="16"/></Button>
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="Aç: .rwmodel veya STL/OBJ/PLY (Ctrl+O)" Click="OnOpen"><t:Icon Data="{StaticResource I.Folder}" Size="16"/></Button>
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="Kaydet (Ctrl+S, farklı kaydet Ctrl+Shift+S)" Click="OnSave"><t:Icon Data="{StaticResource I.Save}" Size="16"/></Button>
                    <Border Width="1" Height="16" Background="{DynamicResource B.Border}" Margin="8,0"/>
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="İçe aktar: STL / OBJ / PLY" Click="OnImport"><t:Icon Data="{StaticResource I.Import}" Size="16"/></Button>
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="Dışa aktar: STL / OBJ / PLY (seçim ya da tüm model)" Click="OnExport"><t:Icon Data="{StaticResource I.Export}" Size="16"/></Button>
                    <Border Width="1" Height="16" Background="{DynamicResource B.Border}" Margin="8,0"/>
                    <Button x:Name="UndoButton" Style="{StaticResource Btn.Icon}" ToolTip="Geri al (Ctrl+Z)" Click="OnUndo"><t:Icon Data="{StaticResource I.Undo}" Size="16"/></Button>
                    <Button x:Name="RedoButton" Style="{StaticResource Btn.Icon}" ToolTip="Yinele (Ctrl+Shift+Z)" Click="OnRedo"><t:Icon Data="{StaticResource I.Redo}" Size="16"/></Button>
                    <Border Width="1" Height="16" Background="{DynamicResource B.Border}" Margin="8,0"/>

                    <Border Background="{DynamicResource B.Surface}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeObject" Style="{StaticResource Chip}" Content="Nesne" GroupName="mode" IsChecked="True" Click="OnModeObject" ToolTip="Nesne modu (Tab)"/>
                            <RadioButton x:Name="ModeEdit" Style="{StaticResource Chip}" Content="Düzenle" GroupName="mode" Click="OnModeEdit" ToolTip="Düzenleme modu: nokta / kenar / yüz (Tab)"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ElementBar" Background="{DynamicResource B.Surface}" CornerRadius="6" Padding="2" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ElVertex" Style="{StaticResource Chip}" Content="Nokta" GroupName="el" IsChecked="True" Click="OnElement" Tag="0" ToolTip="Nokta seçimi (1)"/>
                            <RadioButton x:Name="ElEdge" Style="{StaticResource Chip}" Content="Kenar" GroupName="el" Click="OnElement" Tag="1" ToolTip="Kenar seçimi (2)"/>
                            <RadioButton x:Name="ElFace" Style="{StaticResource Chip}" Content="Yüz" GroupName="el" Click="OnElement" Tag="2" ToolTip="Yüz seçimi (3)"/>
                        </StackPanel>
                    </Border>
                    <Border Width="1" Height="16" Background="{DynamicResource B.Border}" Margin="8,0"/>
                    <Button Style="{StaticResource Btn.Ghost}" Padding="8,0" MinHeight="28" Click="OnAddMenu" ToolTip="Ekle (Shift+A)">
                        <StackPanel Orientation="Horizontal">
                            <t:Icon Data="{StaticResource I.Plus}" Size="16"/>
                            <TextBlock Text="Ekle" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="Birleşim (Boolean ∪): seçili araçları etkin nesneyle birleştir" Click="OnUnion"><t:Icon Data="{StaticResource M.Union}" Size="16"/></Button>
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="Fark (Boolean −): seçili araçları etkin nesneden çıkar (delik, cep)" Click="OnDifference"><t:Icon Data="{StaticResource M.Difference}" Size="16"/></Button>
                    <Button Style="{StaticResource Btn.Icon}" ToolTip="Kesişim (Boolean ∩)" Click="OnIntersect"><t:Icon Data="{StaticResource M.Intersect}" Size="16"/></Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource B.Surface}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ShadeSolid" Style="{StaticResource Chip}" Content="Katı" GroupName="shade" IsChecked="True" Click="OnShading" Tag="0" ToolTip="Katı görünüm (Z)"/>
                            <RadioButton x:Name="ShadeWire" Style="{StaticResource Chip}" Content="Tel" GroupName="shade" Click="OnShading" Tag="1" ToolTip="Tel kafes (Shift+Z)"/>
                            <RadioButton x:Name="ShadeXray" Style="{StaticResource Chip}" Content="X-ray" GroupName="shade" Click="OnShading" Tag="2" ToolTip="Saydam / X-ray (Alt+Z)"/>
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="WireToggle" Style="{StaticResource Chip}" Content="Kenarlar" Margin="6,0,0,0" Click="OnWireOverlay" ToolTip="Katı görünümün üzerinde tel kafes kenarları"/>
                    <ToggleButton x:Name="SnapToggle" Style="{StaticResource Chip}" Content="Yapış" Margin="2,0,0,0" Click="OnSnapToggle" ToolTip="Izgaraya yapış (açıkken Ctrl geçici kapatır)"/>
                    <ComboBox x:Name="GridBox" Width="86" Margin="4,0,0,0" SelectionChanged="OnGridSize" ToolTip="Yapışma adımı">
                        <ComboBoxItem Content="0.1 mm" Tag="0.1"/>
                        <ComboBoxItem Content="0.5 mm" Tag="0.5"/>
                        <ComboBoxItem Content="1 mm" Tag="1" IsSelected="True"/>
                        <ComboBoxItem Content="2 mm" Tag="2"/>
                        <ComboBoxItem Content="5 mm" Tag="5"/>
                        <ComboBoxItem Content="10 mm" Tag="10"/>
                    </ComboBox>
                    <Border Width="1" Height="16" Background="{DynamicResource B.Border}" Margin="10,0"/>
                    <Button x:Name="SendButton" Style="{StaticResource Btn.Primary}" Padding="12,0" MinHeight="28" Click="OnSendToAssembly"
                            ToolTip="Seçili parçaları (seçim yoksa hepsini) projenin Montaj'ına gönder: her parça ayrı bir gövde olur, modellendiği yerde durur. Daha önce gönderilen parça güncellenir, takılı olduğu yer korunur.">
                        <StackPanel Orientation="Horizontal">
                            <t:Icon Data="{StaticResource I.Assembly}" Size="13" Foreground="{DynamicResource B.OnPrimary}"/>
                            <TextBlock Text="Montaja gönder" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource B.OnPrimary}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Main ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="318" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="ViewHost" Grid.Column="0"/>

            <!-- tool strip -->
            <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,12,0,0" Background="{DynamicResource B.Raised}"
                    BorderBrush="{DynamicResource B.BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="3">
                <StackPanel>
                    <RadioButton x:Name="ToolSelect" Style="{StaticResource Toggle.Tool}" GroupName="tool" IsChecked="True" Tag="Select" Click="OnTool" ToolTip="Seç: tıkla / kutu seçimi (W)"><t:Icon Data="{StaticResource I.Pointer}" Size="16"/></RadioButton>
                    <RadioButton x:Name="ToolMove" Style="{StaticResource Toggle.Tool}" GroupName="tool" Tag="Move" Click="OnTool" Margin="0,2,0,0" ToolTip="Taşı tutamacı (G ile serbest taşı)"><t:Icon Data="{StaticResource I.Move}" Size="16"/></RadioButton>
                    <RadioButton x:Name="ToolRotate" Style="{StaticResource Toggle.Tool}" GroupName="tool" Tag="Rotate" Click="OnTool" Margin="0,2,0,0" ToolTip="Döndür tutamacı (R)"><t:Icon Data="{StaticResource I.Rotate}" Size="16"/></RadioButton>
                    <RadioButton x:Name="ToolScale" Style="{StaticResource Toggle.Tool}" GroupName="tool" Tag="Scale" Click="OnTool" Margin="0,2,0,0" ToolTip="Ölçekle tutamacı (S)"><t:Icon Data="{StaticResource M.Scale}" Size="16"/></RadioButton>
                    <Border Height="1" Background="{DynamicResource B.Border}" Margin="4,4"/>
                    <RadioButton x:Name="ToolMeasure" Style="{StaticResource Toggle.Tool}" GroupName="tool" Tag="Measure" Click="OnTool" ToolTip="Ölç: iki noktaya tıklayın (köşelere yapışır)"><t:Icon Data="{StaticResource M.Ruler}" Size="16"/></RadioButton>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource B.Border}"/>

            <!-- right column: outliner + properties / library -->
            <Grid Grid.Column="2" Background="{DynamicResource B.Base}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="230" MinHeight="90"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <Grid DockPanel.Dock="Top" Margin="14,10,10,6">
                        <TextBlock Text="Parçalar" Style="{StaticResource Text.Subtitle}" FontSize="12.5" VerticalAlignment="Center"
                                   ToolTip="En üstteki her nesne ayrı bir parçadır. Altına bağlanan (Ctrl+P) nesneler onunla tek parça olur."/>
                        <TextBlock x:Name="OutlinerCount" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Outliner" Margin="6,0,6,8"/>
                    </ScrollViewer>
                </DockPanel>
                <GridSplitter Grid.Row="1" Height="5" Margin="0,-2" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
                <Border Grid.Row="1" Background="{DynamicResource B.Border}" IsHitTestVisible="False"/>
                <TabControl x:Name="SideTabs" Grid.Row="2">
                    <TabItem Header="Özellikler">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="Props" Margin="14,10,14,16"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Kütüphane">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="Library" Margin="14,10,14,16"/>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" Background="{DynamicResource B.Base}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="StatusText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,420,0"/>
                <TextBlock x:Name="HintText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource B.TextMuted}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
