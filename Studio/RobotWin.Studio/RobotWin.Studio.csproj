<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <AssemblyName>RobotWinStudio</AssemblyName>
    <RootNamespace>RobotWin.Studio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>RobotWin Studio</Product>
    <Version>1.7.0</Version>
    <TieredPGO>true</TieredPGO>
    <ApplicationIcon>Branding/robotwin.ico</ApplicationIcon>
    <!-- [setup] One build for every installation: the exe looks for .NET in its own dotnet\ folder first (the installer's
         ".NET 10 runtime" component), then DOTNET_ROOT, then the PC's installed .NET 10 (a lite installation). -->
    <AppHostDotNetSearch>AppRelative;EnvironmentVariable;Global</AppHostDotNetSearch>
    <AppHostRelativeDotNet>dotnet</AppHostRelativeDotNet>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Firmware\*.hex;Firmware\*.ino;Firmware\rw_esp32_v3.h" CopyToOutputDirectory="PreserveNewest" />
    <!-- [occt] The Open CASCADE bridge for STEP / IGES (third_party/occt, built by tools/scripts/build_occt.bat): beside the app in occt\ -->
    <Content Include="..\..\third_party\occt\win-x64\*.dll" LinkBase="occt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real part models converted from the makers' STEP files (see THIRD_PARTY_NOTICES.md). -->
    <EmbeddedResource Include="Models3D\Bundled\*.obj" LogicalName="RobotWin.Studio.Models3D.Bundled.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Lang\*.json" LogicalName="RobotWin.Studio.Lang.%(Filename)%(Extension)" />
    <!-- [startup] the splash's photo (Simon Kadula, Unsplash License; see THIRD_PARTY_NOTICES.md), until our own artwork -->
    <EmbeddedResource Include="Branding\splash-photo.jpg" LogicalName="RobotWin.Studio.Branding.splash-photo.jpg" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-app help (Yardım, F1): the Turkish user guide, its pictures and the news fallback, copied to Docs\. -->
    <Content Include="..\..\docs\kullanim\**\*" LinkBase="Docs\kullanim" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\..\docs\en\guide\**\*" LinkBase="Docs\en\guide" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\..\docs\images\**\*" LinkBase="Docs\images" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\..\docs\news.json" Link="Docs\news.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CoreSim\src\RobotTwin.CoreSim\RobotTwin.CoreSim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [render] Direct3D bindings only: the renderer itself (Render/) is ours. -->
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>
</Project>
