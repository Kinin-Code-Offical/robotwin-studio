<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RobotWinStudio</AssemblyName>
    <RootNamespace>RobotWin.Studio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>RobotWin Studio</Product>
    <Version>1.6.1</Version>
    <TieredPGO>true</TieredPGO>
    <ApplicationIcon>Branding/robotwin.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Firmware\*.hex;Firmware\*.ino" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real part models converted from the makers' STEP files (see THIRD_PARTY_NOTICES.md). -->
    <EmbeddedResource Include="Models3D\Bundled\*.obj" LogicalName="RobotWin.Studio.Models3D.Bundled.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-app help (Yardım, F1): the Turkish user guide, its pictures and the news fallback, copied to Docs\. -->
    <Content Include="..\..\docs\kullanim\**\*" LinkBase="Docs\kullanim" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\..\docs\images\**\*" LinkBase="Docs\images" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\..\docs\news.json" Link="Docs\news.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CoreSim\src\RobotTwin.CoreSim\RobotTwin.CoreSim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shown natively by WPF the moment the process starts, faded out when the main window is ready. -->
    <SplashScreen Include="Branding\splash.png" />
  </ItemGroup>
</Project>
