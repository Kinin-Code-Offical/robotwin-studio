#include <winver.h>
#include "version.h"

1 ICON "..\\Studio\\RobotWin.Studio\\Branding\\robotwin.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RW_VERSION_NUM
 PRODUCTVERSION RW_VERSION_NUM
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041F04B0"
    BEGIN
      VALUE "CompanyName", "Kinin Code"
      VALUE "FileDescription", "RobotWin Studio Kurulum"
      VALUE "FileVersion", RW_VERSION_STR
      VALUE "ProductName", "RobotWin Studio"
      VALUE "ProductVersion", RW_VERSION_STR
      VALUE "LegalCopyright", "Kinin Code"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x041F, 1200
  END
END
